# Vorlage für den Docker-Betrieb. Kopieren nach .env und ausfüllen:
#   cp .env.docker.example .env

# Passwort der Datenbank. Frei wählbar, wird nur intern verwendet.
# Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=""

# Schlüssel für die Sitzungs-Cookies. Mindestens 32 Zeichen.
# Erzeugen: openssl rand -base64 32
AUTH_SECRET=""

LOG_LEVEL="info"
